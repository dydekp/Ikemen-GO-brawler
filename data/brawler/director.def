; Brawler mode director announcements ([Brawler] DirectorLines in the config)
;
; When the director makes the fight easier or harder, drops an item for a
; player in trouble, a wave starts or is cleared, or a player goes down, comes
; back or joins, it shouts a short line where the fight screen shows FIGHT!
; ([Brawler] DirectorTalk = 1). The lines are shown in the look of FIGHT!,
; smaller: in the fight screen's combo text font, in capitals, in fire colors
; when they challenge the players, in green when they encourage them.
; One line is picked at random, never the same one twice in a row.
; {player} is replaced by the player the decision is about (1P, 2P...).
; Lines with {player} are only used for decisions about one player.
;
; Keep lines short, like shouts: a few words, up to about 20 letters (longer
; ones get smaller). The default font has capitals, digits and ! ? % only:
; apostrophes are left out and other marks become spaces.

[Easier]
; The director gives the players room: be encouraging
line = HANG IN THERE!
line = CATCH YOUR BREATH!
line = YOU GOT THIS!
line = STAY ON YOUR FEET!
line = DONT GIVE UP!
line = SHAKE IT OFF {player}!
line = BREATHE {player}!
line = KEEP FIGHTING {player}!

[Harder]
; The director turns up the heat: be challenging
line = TOO EASY? MORE!
line = HERE COMES MORE!
line = SHOW ME MORE!
line = TURNING UP THE HEAT!
line = NO MORE MERCY!
line = {player} WANTS MORE?
line = TOO COMFY {player}?
line = MORE FOR {player}!

[Help]
; The director drops an item next to a player in trouble ([Level] help):
; always said, even right after another line
line = FOOD DROP!
line = EAT UP {player}!
line = {player} GRAB IT!
line = HANG ON {player}!
line = FOOD FOR {player}!

[Wave]
; A wave starts: get the players going
line = HERE THEY COME!
line = HEADS UP!
line = INCOMING!
line = LOOK ALIVE!

[Boss]
; A wave with a boss starts
line = BOSS INCOMING!
line = HERE COMES THE BOSS!
line = BIG ONE AHEAD!
line = BOSS FIGHT!

[Cleared]
; A wave is cleared
line = AREA CLEAR!
line = NICE WORK!
line = CLEAR! MOVE ON!
line = THATS HOW ITS DONE!

[Close]
; A wave is cleared after a player was in real trouble in it
; ({player}: that player)
line = THAT WAS CLOSE!
line = PHEW!
line = CLOSE ONE {player}!
line = STILL ALIVE {player}!

[Down]
; A player goes down while others fight on ({player}: the one down)
line = {player} DOWN!
line = COVER {player}!
line = {player} IS DOWN! HOLD ON!
line = PROTECT {player}!

[Back]
; A player who was down is back in the fight
line = {player} IS BACK!
line = WELCOME BACK {player}!
line = {player} RETURNS!

[Join]
; A player joins during the level
line = {player} JOINS!
line = HERE COMES {player}!
line = {player} JOINS THE FIGHT!

[Relax]
; The fight peaked: the director gives the team a breather
line = BREATHER!
line = TAKE FIVE!
line = REGROUP!
line = CATCH YOUR BREATH!

[Resume]
; The breather is over
line = BREAK IS OVER!
line = HERE WE GO AGAIN!
line = BACK TO WORK!
line = ROUND TWO!

[Victory]
; The level is cleared and the team lost little life for what it defeated
line = WELL DONE!
line = CLEAN WORK!
line = BARELY A SCRATCH!
line = THATS HOW ITS DONE!

[Survived]
; The level is cleared, but it was rough
line = BARELY MADE IT!
line = SURVIVED!
line = BRUISED BUT STANDING!
line = PATCH UP AND GO!

[LastStand]
; Co-op: a player goes down and only one is left standing ({player}: the one
; still standing). The director also keeps fewer enemies on screen for them
line = {player} STANDS ALONE!
line = ALL ON YOU {player}!
line = HOLD ON {player}!
line = LAST ONE {player}!

[BossLow]
; A boss is down to a quarter of its life
line = FINISH IT!
line = ONE MORE PUSH!
line = ALMOST DOWN!

[BossDown]
; A boss is defeated (said instead of the wave or level line when it was
; the last enemy)
line = BOSS DOWN!
line = AND STAY DOWN!
line = THE BIG ONE FALLS!

[Combo]
; A combo of at least "hits" hits by the players. Named after the player
; when only one plays
hits = 8
line = NICE COMBO!
line = SWEET COMBO!
line = GREAT COMBO {player}!
line = KEEP IT ROLLING {player}!

[Streak]
; "defeats" enemies defeated in a row without a player taking damage
defeats = 5
line = UNTOUCHABLE!
line = FLAWLESS!
line = {player} UNTOUCHABLE!
line = NO SCRATCH {player}!

[GameOver]
; Nobody continued: the level is lost
line = TRY AGAIN!
line = NOT THIS TIME!
line = COME BACK STRONGER!

[Strike]
; A thrown or knocked down enemy knocked over another one or more
; ({player}: who sent it flying)
line = STRIKE!
line = BOWLED OVER!
line = TWO FOR ONE!
line = {player} STRIKE!
