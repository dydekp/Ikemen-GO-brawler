; Demo beat 'em up level. See README.txt in this folder for the format.
; Uses the Z-axis stage and characters shipped with the default Ikemen GO screenpack.

[Level]
name      = Demo Street
stage     = stages/stageZ.def
; Three lanes spread over the stage's topbound/botbound (-30..30)
lanes     = 3
backtrack = 0
; After the last wave, walk to the right end of the stage to finish
endx      = 300

[Enemies]
; alias, character, palette, life, name (life: default is the character's life
; scaled by [Brawler] EnemyLife in the config)
; Any number of enemies. The same character can be listed several times,
; e.g. with other palettes; it is loaded only once.
enemy = thug,    kfm,     7
enemy = thug2,   kfm,     8
enemy = bruiser, kfm,     9
enemy = ninja,   kfm_zss, 3, 50, Shadow Ninja
enemy = big,     kfm720,  2
enemy = boss,    kfm720,  5, 1500, Master Kung Fu
boss  = boss

; Behavior profiles from data/brawler/behaviors.def (or [Behavior name]
; sections in this file). Enemies without one use "default".
behavior = thug,    kicker
behavior = thug2,   jumper
behavior = bruiser, comboer
behavior = ninja,   flanker
behavior = big,     hitrun
behavior = boss,    brute

; Introductions, shown the first time each enemy does its signature move:
; everything else fades into the color, the enemy freezes mid move
[Intro thug]
name     = "Two-Kick" Tony
style    = Street kicks
strength = Never stops kicking
weakness = Forgets to guard
trigger  = attack
color    = 40, 70, 20

[Intro thug2]
name     = Leapfrog Lenny
style    = Over the top
strength = Jumps over you, hits your back
weakness = Lands wide open
trigger  = jump
color    = 70, 45, 20

[Intro bruiser]
name     = The Accountant
style    = Combos
strength = Never stops at one hit
weakness = Needs a breather after
trigger  = attack
delay    = 8
color    = 25, 25, 70

[Intro ninja]
style    = Shadow lanes
strength = Sneaks in through the lanes
weakness = One good punch and he's out
trigger  = lane
color    = 60, 60, 10

[Intro big]
name     = Hit-and-Run Harry
style    = Hit and run
strength = Fast, hard to pin down
weakness = Never finishes a fight
trigger  = run
color    = 10, 55, 60

[Intro boss]
style    = Kung fu master
strength = Specials, guards a lot
weakness = Slow to start
text     = Nobody has walked past him. Yet.
color    = 75, 10, 20

[Wave 1]
; Starts right away
trigger  = -9999
maxalive = 4
; alias(es), side, lane, delay, count
spawn    = thug|thug2, right, player, 30, 3
spawn    = bruiser, left, random, 60, 2

[Wave 2]
; Endless stream of enemies until 8 of them are defeated
trigger  = 60
maxalive = 5
kills    = 8
spawn    = ninja|thug|thug2, random, random, 45, inf

[Wave 3]
trigger  = 180
maxalive = 5
spawn    = big, right, player, 60
spawn    = boss, right, 1, 60
spawn    = thug|thug2|bruiser, random, random, 90, 4
